# ============================================================================
# DevAcademy - environment variables for docker compose
# Copy this file to `.env` and adjust the values before running:
#   cp .env.example .env
#
# NEVER commit the real `.env` file. Only this example is versioned.
# ============================================================================

# --- MySQL ------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=devacademy
MYSQL_USER=devacademy
MYSQL_PASSWORD=devacademy

# --- Backend / API ----------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- Nginx --------------------------------------------------------------
# Host port that exposes the whole application (frontend + API).
NGINX_PORT=8080
