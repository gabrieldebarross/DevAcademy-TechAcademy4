# ============================================================================
# DevAcademy - variáveis de ambiente para o docker compose
# Copie este arquivo para `.env` e ajuste os valores antes de rodar:
#   cp .env.example .env
#
# NUNCA faça commit do `.env` real. Apenas este exemplo é versionado.
# ============================================================================

# --- MySQL ------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=devacademy
MYSQL_USER=devacademy
MYSQL_PASSWORD=devacademy

# --- Backend / API ----------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- Nginx ------------------------------------------------------------------
# Porta no host que expõe a aplicação inteira (frontend + API).
NGINX_PORT=8080
