{
  // Configuração do projeto OpenCode para o DevAcademy.
  // Guardrails que limitam o que o agente pode fazer.
  "$schema": "https://opencode.ai/config.json",

  "instructions": ["AGENTS.md"],

  // As regras são avaliadas em ordem e a ÚLTIMA regra que casa vence.
  "permissions": [
    // --- Arquivos sensíveis: o agente nunca deve ler nem escrever segredos --
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    // --- Guardrails de shell: bloquear comandos destrutivos / de exfiltração -
    { "action": "shell", "resource": "cat *.env*", "effect": "deny" },
    { "action": "shell", "resource": "type *.env*", "effect": "deny" },
    { "action": "shell", "resource": "Get-Content *.env*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "docker compose down -v*", "effect": "deny" },
    { "action": "shell", "resource": "docker volume rm *", "effect": "deny" },

    // --- Qualquer coisa fora do projeto exige aprovação explícita ----------
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],

  // Agente revisor somente-leitura usado pela skill `review-requirements`.
  "agents": {
    "reviewer": {
      "description": "Audita o projeto contra os requisitos do curso sem alterar arquivos",
      "mode": "subagent",
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }]
    }
  }
}
