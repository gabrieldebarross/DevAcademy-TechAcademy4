# ============================================================================
# DevAcademy - environment variables for a cloud deployment (VM/VPS)
#
# This is a TEMPLATE. Copy it to the real `.env` file before deploying:
#   cp env.production.example .env
#
# NEVER commit the real `.env` file. Only this template is versioned.
# ============================================================================

# --- Public port (Nginx) ----------------------------------------------------
# 80 = default HTTP. Use 443 if you terminate TLS directly on Nginx.
HOST_PORT=80

# --- MySQL ------------------------------------------------------------------
# Use strong, unique passwords (different from the development ones).
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=devacademy
MYSQL_USER=devacademy
MYSQL_PASSWORD=change-me-database-password

# --- Backend / API ----------------------------------------------------------
# Generate a long random secret, for example:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Let TypeORM create the tables on the first deploy.
# Set to "false" once the schema is stable (or after adding migrations).
DB_SYNCHRONIZE=true
