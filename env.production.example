# ============================================================================
# DevAcademy - variáveis de ambiente para deploy na nuvem (VM/VPS)
#
# Este é um MODELO. Copie para o arquivo `.env` real antes de fazer o deploy:
#   cp env.production.example .env
#
# NUNCA faça commit do `.env` real. Apenas este modelo é versionado.
# ============================================================================

# --- Porta pública (Nginx) --------------------------------------------------
# 80 = HTTP padrão. Use 443 se encerrar o TLS diretamente no Nginx.
HOST_PORT=80

# --- MySQL ------------------------------------------------------------------
# Use senhas fortes e únicas (diferentes das de desenvolvimento).
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=devacademy
MYSQL_USER=devacademy
MYSQL_PASSWORD=change-me-database-password

# --- Backend / API ----------------------------------------------------------
# Gere um segredo longo e aleatório, por exemplo:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Deixe o TypeORM criar as tabelas no primeiro deploy.
# Defina "false" quando o schema estiver estável (ou após adicionar migrations).
DB_SYNCHRONIZE=true
